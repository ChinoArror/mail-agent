+      e.preventDefault();
+      setTouched(true);
+      const [dx, dy] = moves[e.key];
+      apply({ ...state, ox: state.ox + dx / frame.w, oy: state.oy + dy / frame.h }, true);
+    } else if (e.key === "+" || e.key === "=") {
