diff --git a/workers_mail_app_package/src/client/auth.tsx b/workers_mail_app_package/src/client/auth.tsx
new file mode 100644
index 0000000..5d9e5bc
--- /dev/null
+++ b/workers_mail_app_package/src/client/auth.tsx
@@ -0,0 +1,186 @@
+import React, { useEffect, useRef, useState } from "react";
+import { ArrowRight, Bot, Check, LogIn, Paperclip, ShieldCheck, Sparkles, X, Zap } from "lucide-react";
+import { ThemeToggle } from "./components";
+import { LoginWaves } from "./ui/waves";
+import { api, authLoginUrl, getPublicConfig, tokenKey, type PublicConfig } from "./lib";
+
+const RENEW_KEY = "mail_agent_renew_at";
+
+/** Redirect to Auth Center. If its refresh cookie is still valid, it re-issues a JWT without a prompt. */
+export async function redirectToAuthCenter(config?: PublicConfig) {
+  const cfg = config || (await getPublicConfig());
+  window.location.href = authLoginUrl({ ...cfg, callback_url: cfg.callback_url || `${window.location.origin}/sso-callback` });
+}
+
+/** Silent renewal guard: at most one automatic round-trip per minute to avoid redirect loops. */
+export function canAutoRenew() {
+  const last = Number(sessionStorage.getItem(RENEW_KEY) || 0);
+  return Date.now() - last > 60_000;
+}
+export function markRenewAttempt() {
+  sessionStorage.setItem(RENEW_KEY, String(Date.now()));
+}
+
+function LandingBackdrop({ config }: { config: PublicConfig | null }) {
+  const url = config?.landing_background_url;
+  const [loaded, setLoaded] = useState(false);
+  useEffect(() => {
+    if (!url) return;
+    const img = new Image();
+    img.onload = () => setLoaded(true);
+    img.src = url;
+  }, [url]);
+  return (
+    <>
+      {url && loaded && <div className="login-bg" style={{ backgroundImage: `url(${url})`, ["--landing-opacity" as string]: String(config?.landing_background_opacity ?? 0.18) }} />}
+      <LoginWaves />
+      <div className="login-glow" />
+    </>
+  );
+}
+
+export function Login({ notice }: { notice?: string }) {
+  const [config, setConfig] = useState<PublicConfig | null>(null);
+  const [redirecting, setRedirecting] = useState(false);
+  useEffect(() => { void getPublicConfig().then(setConfig); }, []);
+  const login = async () => {
+    setRedirecting(true);
+    markRenewAttempt();
+    await redirectToAuthCenter(config || undefined);
+  };
+  return (
+    <main className={`login ${config?.landing_background_url ? "has-bg" : ""}`}>
+      <LandingBackdrop config={config} />
+      <ThemeToggle />
+      <div className="login-stack">
+        <section className="login-card">
+          <div className="login-mark"><img src="/logo.svg" alt="" /></div>
+          <h1>Mail Agent <span className="ver">beta</span></h1>
+          <p className="lede">Temporary mail with real delivery, drafts and AI assist.</p>
+          <div className="login-features">
+            <div><Zap size={16} />Disposable addresses on your own domain</div>
+            <div><Paperclip size={16} />Attachments stored safely in R2</div>
+            <div><Bot size={16} />Gemini drafts, replies and translations</div>
+          </div>
+          {notice && <div className="alert info" style={{ marginBottom: 14, textAlign: "left" }}>{notice}</div>}
+          <button className="primary go" onClick={() => void login()} disabled={redirecting}>
+            {redirecting ? <span className="ring-spinner" style={{ borderColor: "color-mix(in oklab, currentColor 30%, transparent)", borderTopColor: "currentColor" }} /> : <LogIn size={18} />}
+            {redirecting ? "Redirecting to Auth Center…" : "Continue with Auth Center"}
+            {!redirecting && <ArrowRight className="arrow" size={17} />}
+          </button>
+          <p className="fine">Identity and permissions are verified server-side on every request.</p>
+        </section>
+        <div className="login-help"><ShieldCheck size={14} />Single sign-on by Aryuki Auth Center</div>
+      </div>
+    </main>
+  );
+}
+
+/* ---------- Boot / sign-in progress screen --------------------------------- */
+type StepState = "pending" | "active" | "done" | "error";
+
+export function BootScreen({ title, subtitle, steps, progress, error, actions }: { title: string; subtitle: string; steps: Array<{ label: string; state: StepState }>; progress: number | null; error?: boolean; actions?: React.ReactNode }) {
+  const allDone = steps.every((s) => s.state === "done");
+  return (
+    <main className="login">
+      <LoginWaves />
+      <div className="login-glow" />
+      <section className="login-card boot-card" aria-live="polite">
+        <div className="boot-head">
+          <div className={`boot-orbit ${allDone ? "done" : ""} ${error ? "error" : ""}`}><img src="/logo.svg" alt="" /></div>
+          <div>
+            <strong>{title}</strong>
+            <small>{subtitle}</small>
+          </div>
+        </div>
+        <div className="boot-steps">
+          {steps.map((s) => (
+            <div key={s.label} className={`boot-step ${s.state}`}>
+              <span className="dot">
+                {s.state === "active" && <span className="ring-spinner" style={{ width: 14, height: 14 }} />}
+                {s.state === "done" && <Check size={12} strokeWidth={3} />}
+                {s.state === "error" && <X size={12} strokeWidth={3} />}
+              </span>
+              {s.label}
+            </div>
+          ))}
+        </div>
+        {!error && (
+          <div className="boot-bar progress-track"><b style={{ width: `${Math.round((progress ?? 0) * 100)}%` }} /></div>
+        )}
+        {actions && <div className="boot-actions">{actions}</div>}
+      </section>
+    </main>
+  );
+}
+
+export function Callback({ onDone }: { onDone: () => void }) {
+  const [phase, setPhase] = useState<0 | 1 | 2 | 3>(0);
+  const [error, setError] = useState("");
+  const ran = useRef(false);
+  const run = async () => {
+    setError("");
+    const token = new URLSearchParams(window.location.search).get("token") || sessionStorage.getItem("mail_agent_pending_token");
+    // Never leave a JWT in the address bar / history.
+    window.history.replaceState({}, "", "/sso-callback");
+    if (!token) {
+      setError("The sign-in response did not include a token.");
+      return;
+    }
+    sessionStorage.setItem("mail_agent_pending_token", token);
+    setPhase(1);
+    try {
+      await api<{ token: string }>("/api/sso-callback", { method: "POST", body: JSON.stringify({ token }) });
+      localStorage.setItem(tokenKey, token);
+      sessionStorage.removeItem("mail_agent_pending_token");
+      setPhase(2);
+      await api("/api/me");
+      setPhase(3);
+      window.setTimeout(() => {
+        window.history.replaceState({}, "", "/");
+        onDone();
+      }, 280);
+    } catch (err) {
+      setError(err instanceof Error ? err.message : "Sign-in failed");
+    }
+  };
+  useEffect(() => {
+    if (ran.current) return;
+    ran.current = true;
+    void run();
+  }, []);
+  const state = (i: number): StepState => (error && phase === i ? "error" : phase > i ? "done" : phase === i ? "active" : "pending");
+  return (
+    <BootScreen
+      title={error ? "Sign-in didn't complete" : phase === 3 ? "Welcome back" : "Signing you in"}
+      subtitle={error || (phase === 3 ? "Opening your workspace…" : "This usually takes a second.")}
+      error={!!error}
+      progress={[0.12, 0.45, 0.8, 1][phase]}
+      steps={[
+        { label: "Received token from Auth Center", state: state(0) },
+        { label: "Verifying identity and app access", state: state(1) },
+        { label: "Loading your workspace", state: state(2) }
+      ]}
+      actions={error ? (
+        <>
+          <button onClick={() => { sessionStorage.removeItem("mail_agent_pending_token"); window.location.replace("/"); }}>Back</button>
+          <button className="primary" onClick={() => { markRenewAttempt(); void redirectToAuthCenter(); }}><Sparkles size={15} />Sign in again</button>
+        </>
+      ) : undefined}
+    />
+  );
+}
+
+export function RenewScreen() {
+  return (
+    <BootScreen
+      title="Renewing your session"
+      subtitle="Your sign-in expired — refreshing it with Auth Center."
+      progress={0.5}
+      steps={[
+        { label: "Session expired", state: "done" },
+        { label: "Requesting a new token", state: "active" }
+      ]}
+    />
+  );
+}
diff --git a/workers_mail_app_package/src/client/components.tsx b/workers_mail_app_package/src/client/components.tsx
new file mode 100644
index 0000000..9261e45
--- /dev/null
+++ b/workers_mail_app_package/src/client/components.tsx
@@ -0,0 +1,151 @@
+import React, { useEffect, useRef, useState } from "react";
+import { CircleAlert, Monitor, Moon, RefreshCw, Sun } from "lucide-react";
+import { SkeletonSwap } from "./ui/skeleton";
+import { useThemeMode, type ThemeMode } from "./lib";
+
+export function StatusPill({ value, label }: { value: string; label?: string }) {
+  return <span className={`pill ${value.replace(/\s+/g, "_").toLowerCase()}`}>{label || value.replace(/_/g, " ")}</span>;
+}
+
+export function EmptyState({ title, hint, icon: Icon, action }: { title: string; hint?: string; icon: React.ElementType; action?: React.ReactNode }) {
+  return (
+    <div className="empty">
+      <span className="empty-icon"><Icon size={22} /></span>
+      <span>{title}</span>
+      {hint && <small>{hint}</small>}
+      {action}
+    </div>
+  );
+}
+
+export function ErrorPanel({ message, onRetry }: { message: string; onRetry?: () => void }) {
+  return (
+    <div className="alert" role="alert" style={{ alignItems: "center" }}>
+      <CircleAlert size={16} />
+      <span style={{ flex: 1 }}>{message}</span>
+      {onRetry && <button className="small-button" onClick={onRetry}><RefreshCw size={14} />Retry</button>}
+    </div>
+  );
+}
+
+/**
+ * Wraps an async data panel: shimmer skeleton on first load (Skeleton Swap),
+ * dimmed stale content while refreshing, inline error with retry.
+ */
+export function Loadable<T>({
+  state,
+  skeleton,
+  children,
+  label
+}: {
+  state: { data: T | null; error: string; loading: boolean; reload: () => Promise<void> | void };
+  skeleton: React.ReactNode;
+  children: (data: T) => React.ReactNode;
+  label?: string;
+}) {
+  if (state.error && !state.data) return <ErrorPanel message={state.error} onRetry={() => void state.reload()} />;
+  return (
+    <SkeletonSwap ready={state.data !== null} skeleton={skeleton} label={label}>
+      <div className={state.loading ? "is-refreshing" : undefined}>
+        {state.error && <div style={{ marginBottom: 12 }}><ErrorPanel message={state.error} onRetry={() => void state.reload()} /></div>}
+        {state.data !== null && children(state.data)}
+      </div>
+    </SkeletonSwap>
+  );
+}
+
+/** E1 · segmented control with an inverted-label thumb. */
+export function Segmented<T extends string | number>({ value, options, onChange, ariaLabel }: { value: T; options: Array<{ value: T; label: string }>; onChange: (value: T) => void; ariaLabel: string }) {
+  const idx = Math.max(0, options.findIndex((o) => o.value === value));
+  const n = options.length;
+  const refs = useRef<Array<HTMLButtonElement | null>>([]);
+  const labels = options.map((o) => <span key={String(o.value)}>{o.label}</span>);
+  return (
+    <div className="segmented" role="radiogroup" aria-label={ariaLabel}>
+      <div className="segmented-labels" aria-hidden="true">{labels}</div>
+      <div className="segmented-thumb" aria-hidden="true" style={{ width: `calc((100% - 6px) / ${n})`, transform: `translateX(${idx * 100}%)` }}>
+        <div className="segmented-thumb-labels" style={{ width: `${n * 100}%`, transform: `translateX(${(-idx * 100) / n}%)` }}>{labels}</div>
+      </div>
+      <div className="segmented-hit">
+        {options.map((o, i) => (
+          <button
+            key={String(o.value)}
+            ref={(el) => { refs.current[i] = el; }}
+            role="radio"
+            aria-checked={i === idx}
+            aria-label={o.label}
+            tabIndex={i === idx ? 0 : -1}
+            onClick={() => onChange(o.value)}
+            onKeyDown={(e) => {
+              const next = e.key === "ArrowRight" || e.key === "ArrowDown" ? (idx + 1) % n : e.key === "ArrowLeft" || e.key === "ArrowUp" ? (idx - 1 + n) % n : e.key === "Home" ? 0 : e.key === "End" ? n - 1 : -1;
+              if (next < 0) return;
+              e.preventDefault();
+              onChange(options[next].value);
+              refs.current[next]?.focus();
+            }}
+          />
+        ))}
+      </div>
+    </div>
+  );
+}
+
+/** Three-way theme toggle (system / light / dark) with a sliding primary disc. */
+export function ThemeToggle({ inline = false }: { inline?: boolean }) {
+  const [mode, setMode] = useThemeMode();
+  const modes: Array<{ value: ThemeMode; label: string; Icon: React.ElementType }> = [
+    { value: "system", label: "System theme", Icon: Monitor },
+    { value: "light", label: "Light theme", Icon: Sun },
+    { value: "dark", label: "Dark theme", Icon: Moon }
+  ];
+  const idx = modes.findIndex((m) => m.value === mode);
+  return (
+    <div className={`theme-toggle ${inline ? "inline" : ""}`} role="radiogroup" aria-label="Theme">
+      <span className="thumb" style={{ transform: `translateX(${idx * 36}px)` }} />
+      {modes.map((m) => (
+        <button key={m.value} role="radio" aria-checked={mode === m.value} aria-label={m.label} title={m.label} className={mode === m.value ? "on" : ""} onClick={(e) => setMode(m.value, { x: e.clientX, y: e.clientY })}>
+          <m.Icon size={15} />
+        </button>
+      ))}
+    </div>
+  );
+}
+
+/** Closes a popover when clicking outside or pressing Escape. */
+export function useDismiss(open: boolean, onClose: () => void) {
+  const ref = useRef<HTMLDivElement | null>(null);
+  useEffect(() => {
+    if (!open) return;
+    const onDown = (e: MouseEvent) => { if (ref.current && !ref.current.contains(e.target as Node)) onClose(); };
+    const onKey = (e: KeyboardEvent) => { if (e.key === "Escape") onClose(); };
+    document.addEventListener("mousedown", onDown);
+    document.addEventListener("keydown", onKey);
+    return () => {
+      document.removeEventListener("mousedown", onDown);
+      document.removeEventListener("keydown", onKey);
+    };
+  }, [open]);
+  return ref;
+}
+
+/** Dropdown menu: trigger + floating panel. */
+export function Menu({ trigger, children, align = "right", label }: { trigger: (props: { open: boolean; toggle: () => void }) => React.ReactNode; children: (close: () => void) => React.ReactNode; align?: "left" | "right"; label?: string }) {
+  const [open, setOpen] = useState(false);
+  const ref = useDismiss(open, () => setOpen(false));
+  return (
+    <div className="dropdown" ref={ref}>
+      {trigger({ open, toggle: () => setOpen((v) => !v) })}
+      {open && <div className={`dropdown-menu ${align === "right" ? "right" : ""}`} role="menu" aria-label={label}>{children(() => setOpen(false))}</div>}
+    </div>
+  );
+}
+
+export function QuotaBar({ label, value, limit, percent }: { label: string; value: string | number; limit: string | number; percent: number }) {
+  const tone = percent >= 90 ? "danger" : percent >= 70 ? "warn" : "";
+  return (
+    <div className={`quota-bar ${tone}`}>
+      <div><strong>{label}</strong><span>{value} / {limit}</span></div>
+      <i><b style={{ width: `${Math.max(0, Math.min(100, percent))}%` }} /></i>
+    </div>
+  );
+}
